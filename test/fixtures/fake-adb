#!/usr/bin/env python3
from __future__ import annotations

import hashlib
import os
import sys

args = sys.argv[1:]
serial = ""
if len(args) >= 2 and args[0] == "-s":
    serial = args[1]
    args = args[2:]

if args in (["devices"], ["devices", "-l"]):
    print("List of devices attached")
    for line in os.environ.get("FAKE_ADB_DEVICES", "").splitlines():
        if line.strip():
            print(line)
    raise SystemExit(0)

if args == ["--version"]:
    print("Android Debug Bridge version 1.0.41")
    print("Version 37.0.1-12345678")
    raise SystemExit(0)

if args and args[0] == "shell":
    rest = args[1:]
    if rest == ["getprop"]:
        print(open(os.environ["FAKE_PROPS"], encoding="utf-8").read(), end="")
        raise SystemExit(0)
    if rest[:2] == ["settings", "get"]:
        print(os.environ.get("FAKE_OEM_ALLOWED", "1"))
        raise SystemExit(0)
    if rest and rest[0] == "getprop":
        for line in open(os.environ["FAKE_PROPS"], encoding="utf-8"):
            if line.startswith(f"[{rest[1]}]: ["):
                print(line.split("]: [", 1)[1].rsplit("]", 1)[0])
                break
        raise SystemExit(0)
    if rest == ["su", "-c", "id"]:
        print(os.environ.get("FAKE_ROOT", "uid=0(root) gid=0(root) context=u:r:magisk:s0"))
        raise SystemExit(0)
    if "sha256sum" in " ".join(rest):
        data = os.environ.get("FAKE_BLOCK_DATA", "flashkit-test-block").encode()
        print(hashlib.sha256(data).hexdigest())
        raise SystemExit(0)
    if rest and rest[0] == "ls":
        print(os.environ.get("FAKE_BLOCKS", "boot_a\nboot_b\ndtbo_a\ndtbo_b\n"), end="")
        raise SystemExit(0)
    print("")
    raise SystemExit(0)

if args and args[0] == "exec-out":
    sys.stdout.buffer.write(os.environ.get("FAKE_BLOCK_DATA", "flashkit-test-block").encode())
    raise SystemExit(0)

if args and args[0] == "sideload":
    print("serving: 'flashkit-test.zip' 100%")
    raise SystemExit(0)

if args and args[0] == "reboot":
    print("rebooting")
    raise SystemExit(0)

print(f"onverwacht adb-commando: {args}", file=sys.stderr)
raise SystemExit(1)
